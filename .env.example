# Скопируйте этот файл в .env и заполните значения: cp .env.example .env

# Домен сайта без https:// и без www, например maski-snyaty.ru
DOMAIN=maski-snyaty.ru

# Почта для уведомлений о HTTPS-сертификате (Let's Encrypt)
ACME_EMAIL=you@example.ru

# Пароль базы данных. Только латинские буквы и цифры, сгенерируйте командой:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Часовой пояс клуба (Смоленск — московское время)
CLUB_TZ=Europe/Moscow

# Через сколько дней обезличивать имена и контакты в заявках
BOOKING_RETENTION_DAYS=365

# Сколько дней хранить ежедневные резервные копии
BACKUP_KEEP_DAYS=14

# Telegram-бот для уведомлений о новых заявках (необязательно).
# Создайте бота у @BotFather и вставьте токен. Затем в админке: «Telegram» → «Подключить».
TELEGRAM_BOT_TOKEN=
